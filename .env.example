# Local development: copy this file to ".env" and fill in the values.
# Never commit .env (it is in .gitignore).
SECRET_KEY=replace-with-a-long-random-string
BAND_CODE=secret-band-word
FLASK_DEBUG=1

# MySQL. On Railway these are provided by the MySQL service (see README).
# Locally, use the values of the MySQL service's public connection.
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
